<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head.ejs', { title, cssPath: 'category-form.css' }) %>
<body>
    <%- include('../partials/navbar.ejs') %>

    <main class="category-form-page">
        <a href="/category" class="back-link">← Back to Categories</a>

        <section class="form-container">
            <div class="form-heading">
                <span class="eyebrow">NEXUS INVENTORY</span>
                <h1>Create Category</h1>
                <p>Add a category to organize your store's inventory.</p>
            </div>

            <form action="/category/new" method="POST">
                <div class="form-group">
                    <label for="name">Category Name</label>
                    <input
                        type="text"
                        id="name"
                        name="name"
                        placeholder="e.g. Laptops"
                        maxlength="100"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="description">Description <span class="optional">(Optional)</span></label>
                    <textarea
                        id="description"
                        name="description"
                        rows="4"
                        placeholder="Describe the products in this category..."
                    ></textarea>
                    <span class="field-hint">A short description helps customers understand this category.</span>
                </div>

                <div class="form-actions">
                    <a href="/category" class="button button-secondary">Cancel</a>
                    <button type="submit" class="button button-primary">Create Category</button>
                </div>
            </form>
        </section>
    </main>

    <%- include('../partials/footer.ejs') %>
</body>
</html>